@startuml
actor Admin
participant "Web UI" as UI
participant "Room Service" as ROOM
participant "Accounts Service" as ACC
database "PostgreSQL" as DB
participant "Audit Log" as LOG
Admin -> UI: choose student and room, submit
UI -> ROOM: allocate(student_id, room_id)
ROOM -> ACC: is_verified(student_id)
ACC --> ROOM: registration status
alt student not Verified or already allocated
  ROOM --> UI: AllocationError
  UI --> Admin: same page, red banner, nothing saved
else student eligible
  ROOM -> DB: lock room row, count allocations (one transaction)
  DB --> ROOM: capacity, occupied
  alt room full
    ROOM --> UI: AllocationError
    UI --> Admin: red banner "Room ... is full"
  else room available
    ROOM -> DB: save allocation, update room status (same transaction)
    DB --> ROOM: ok
    DB -> LOG: post_save signal: log allocation
    ROOM --> UI: success
    UI --> Admin: redirect, green banner
  end
end
@enduml