@startuml
actor Admin
participant "Web UI" as UI
participant "Fee Service" as FEE
database "PostgreSQL" as DB
participant "Audit Log" as LOG
Admin -> UI: enter student, amount, date, submit
UI -> FEE: record_payment(student_id, amount, date)
FEE -> DB: lock fee row, read fee amount and total paid (one transaction)
DB --> FEE: fee_total, paid
FEE -> FEE: outstanding = fee_total - paid
alt amount <= 0, amount > outstanding or date in the future
  FEE --> UI: FeeError
  UI --> Admin: same page, red banner and field error, nothing saved
else amount valid
  FEE -> DB: insert payment record (same transaction)
  DB --> FEE: ok
  DB -> LOG: post_save signal: log payment recorded
  FEE --> UI: new outstanding
  UI --> Admin: redirect, green banner with outstanding balance
end
@enduml