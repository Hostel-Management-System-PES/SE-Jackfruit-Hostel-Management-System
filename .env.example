# Environment variables read by hms/settings.py.
# Without POSTGRES_DB the app uses a local SQLite file (db.sqlite3).
# docker-compose.yml already sets the PostgreSQL values for you.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
